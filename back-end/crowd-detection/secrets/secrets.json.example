{
  "sources": [
    {
      "id": "lift",
      "rtsp_url": "rtsp://user:pass@10.0.0.1:554/live/main"
    },
    {
      "id": "hall",
      "rtsp_url": "rtsp://user:pass@10.0.0.2:554/live/main"
    }
  ],
  "zones": [
    {
      "id": "z1",
      "camera_id": "lift",
      "name": "Main entrance",
      "max_capacity": 80
    },
    {
      "id": "z2",
      "camera_id": "hall",
      "name": "Hall",
      "max_capacity": 300
    }
  ],
  "ws_broadcast_interval_sec": 3,
  "DB_HOST": "crowd-db",
  "DB_NAME": "crowd_detection",
  "DB_USER": "postgres",
  "DB_PASSWORD": "postgres",
  "PORT": 5432,
  "inference_enabled": true,
  "model_path": "models_yolo/yolo11x.pt",
  "yolo_conf": 0.35,
  "crowd_min_people": 5,
  "crowd_iou_threshold": 0.0,
  "crowd_overlap_mode": "adaptive",
  "crowd_adaptive_dist_mult": 1.2,
  "crowd_center_dist_fraction": 0.06,
  "crowd_roi_mode": "center",
  "crowd_timeout_sec": 2,
  "write_interval_sec": 30,
  "roi_box": [
    0,
    0,
    1920,
    1080
  ],
  "roi_base_w": 1920,
  "roi_base_h": 1080,
  "output_dir": "images",
  "show": "0",
  "log_level": "INFO"
}
