FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
  && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

COPY requirements-model.txt /app/requirements-model.txt
RUN pip install --no-cache-dir -r /app/requirements-model.txt

COPY . /app

# WORKDIR is set to /app/model so that config.py, utils.py etc. are importable
# as flat modules (import config, import utils) without package prefixes.
WORKDIR /app/model
CMD ["python", "detection.py"]