# Copy to secrets/config.yaml and set real camera/model values before deploy.

postgres:
  url: "postgresql+asyncpg://postgres:postgres@fall-db:5432/fall3d"

api:
  host: "0.0.0.0"
  port: 8000
  log_level: "info"

cameras:
  - name: "cam-1"
    rtsp: "rtsp://user:pass@10.0.0.1:554/live/main"
  - name: "cam-2"
    rtsp: "rtsp://user:pass@10.0.0.2:554/live/main"

inference:
  ckpt: "/data/outputs/new-data/best.pt"
  yolo_model: "/data/yolov8m.pt"
  device: "cuda"

  fall_threshold: 0.8
  people_min: 2
  clip_len: 16
  stride: 4

  show: 0
  save_dir: "/data/outputs/multi"

  yolo_conf: 0.25
  yolo_iou: 0.7
