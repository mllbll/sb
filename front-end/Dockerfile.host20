# Сборка дашборда для двухузлового развёртывания (ПК 192.168.1.20).
# Контекст сборки: каталог front-end (не корень репозитория).

FROM node:20-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# .env.production в git нет — задаём явно для production-сборки
ENV VITE_USE_MOCK=false
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.host20.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
